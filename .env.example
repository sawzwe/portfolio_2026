# --- Supabase (read by @nuxtjs/supabase) ---
# Project Settings → Data API → Project URL
SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"

# Project Settings → API Keys → publishable key (starts with sb_publishable_)
# Safe to expose to the browser.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# Project Settings → API Keys → secret key (starts with sb_secret_)
# Server-side only — used by the module's service client and scripts/seed.mjs
# to bypass RLS. NEVER expose this to the client.
SUPABASE_SECRET_KEY="sb_secret_xxx"

# --- App ---
# Public base URL, used for auth email redirect links in production.
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
