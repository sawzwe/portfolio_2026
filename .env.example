# --- Supabase (read by @nuxtjs/supabase) ---
# Project Settings → API → Project URL
SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
# Project Settings → API → Project API keys → anon / public
SUPABASE_KEY="your-anon-public-key"

# --- Seed script only (server-side, NEVER expose to the client) ---
# Project Settings → API → Project API keys → service_role (secret)
# Used by scripts/seed.mjs to bypass RLS when importing initial data.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# --- App ---
# Public base URL, used for auth email redirect links in production.
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
